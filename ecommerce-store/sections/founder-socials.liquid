<section class="founder-section">
  <div class="founder-inner">
    <!-- Contact Info -->
    <div class="founder-contact">
      <h3>Mail</h3>
      <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
    </div>

    <!-- Avatar -->
    <div class="founder-avatar-wrap">
      {% if section.settings.avatar != blank %}
        <img src="{{ section.settings.avatar | image_url: width: 300 }}" alt="{{ section.settings.founder_name }}" class="founder-avatar">
      {% else %}
        <img src="{{ 'founder-avatar.jpg' | asset_url }}" alt="{{ section.settings.founder_name }}" class="founder-avatar">
      {% endif %}
      <h4 class="founder-name">{{ section.settings.founder_name }}</h4>
      <p class="founder-title">{{ section.settings.founder_title }}</p>
    </div>

    <!-- Social Links -->
    <div class="founder-socials">
      {% if section.settings.facebook_url != blank %}
        <a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener" aria-label="Facebook">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </a>
      {% endif %}
      {% if section.settings.instagram_url != blank %}
        <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
        </a>
      {% endif %}

      {% if section.settings.tiktok_url != blank %}
        <a href="{{ section.settings.tiktok_url }}" target="_blank" rel="noopener" aria-label="TikTok">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
        </a>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .founder-section {
    background: var(--color-surface-warm, #f5f1ea);
    padding: 4rem 1.5rem;
    border-top: 1px solid rgba(196,200,188,0.3);
  }
  .founder-inner {
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }
  .founder-contact h3 {
    font-family: var(--font-heading-family);
    color: var(--color-foreground);
    font-size: 1.125rem;
    margin-bottom: 0.375rem;
  }
  .founder-contact a {
    color: #4a4e4a;
    font-size: 0.9375rem;
    transition: color 0.2s;
  }
  .founder-contact a:hover { color: var(--color-primary); }
  .founder-avatar {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 25%;
    border: 3px solid rgba(74,124,89,0.2);
    margin-bottom: 0.75rem;
  }
  .founder-name {
    font-family: var(--font-heading-family);
    color: var(--color-foreground);
    font-size: 1.0625rem;
    margin-bottom: 0.125rem;
  }
  .founder-title {
    color: #4a4e4a;
    font-size: 0.8125rem;
  }
  .founder-socials {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .founder-socials a {
    color: #4a4e4a;
    transition: color 0.2s, transform 0.2s, background 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(74,124,89,0.08);
  }
  .founder-socials a:hover {
    color: var(--color-primary);
    transform: scale(1.1);
    background: rgba(74,124,89,0.15);
  }
  @media (min-width: 768px) {
    .founder-section { padding: 5rem 3rem; }
    .founder-avatar { width: 140px; height: 140px; }
  }
</style>

{% schema %}
{
  "name": "Founder & Socials",
  "settings": [
    { "type": "text", "id": "founder_name", "label": "Name", "default": "Your Name" },
    { "type": "text", "id": "founder_title", "label": "Title", "default": "Founder, Nature Heals" },
    { "type": "image_picker", "id": "avatar", "label": "Avatar Photo" },
    { "type": "text", "id": "email", "label": "Email", "default": "natureheals.shopify@gmail.com" },
    { "type": "url", "id": "facebook_url", "label": "Facebook URL" },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "url", "id": "tiktok_url", "label": "TikTok URL" }
  ],
  "presets": [{ "name": "Founder & Socials" }]
}
{% endschema %}
