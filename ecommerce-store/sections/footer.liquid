<footer class="site-footer full-width">
  <div class="footer-inner">
    <div class="footer-brand">{{ shop.name }}</div>
    
    <div class="footer-links">
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>
    
    <div class="footer-bottom">
      {% if section.settings.show_payment_icons %}
        <div class="payment-icons">
          {% for type in shop.enabled_payment_types %}
            {{ type | payment_type_svg_tag }}
          {% endfor %}
        </div>
      {% endif %}
      <span>&copy; {{ 'now' | date: "%Y" }} {{ shop.name }}. Rooted in Nature.</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true }
  ]
}
{% endschema %}
