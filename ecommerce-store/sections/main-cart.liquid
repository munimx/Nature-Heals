<section style="flex:1;max-width:1280px;margin:0 auto;padding:6rem 1.5rem 4rem;width:100%">
  {% if cart.item_count > 0 %}
    <div style="display:flex;flex-direction:column;gap:3rem">
      <div style="display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid rgba(196,200,188,0.3);padding-bottom:1.5rem">
        <h1 style="font-family:var(--font-heading-family);font-size:2.5rem">Your Cart</h1>
        <span style="color:#6b6358;font-size:0.9375rem">{{ cart.item_count }} items</span>
      </div>

      <div style="display:flex;flex-direction:column;gap:3rem">
        <form action="{{ routes.cart_url }}" method="post" id="cart">
          <div style="display:flex;flex-direction:column;gap:1.5rem">
            {% for item in cart.items %}
              <div class="cart-item" style="padding:1.5rem">
                <div style="width:96px;height:96px;border-radius:8px;overflow:hidden;flex-shrink:0;background:#eae6de">
                  {% if item.image %}
                    <img src="{{ item.image | image_url: width: 300 }}" alt="{{ item.image.alt | escape }}" style="width:100%;height:100%;object-fit:cover">
                  {% endif %}
                </div>
                <div class="cart-item-info" style="flex:1;gap:0.5rem">
                  <div style="display:flex;justify-content:space-between;align-items:start">
                    <div>
                      <span class="cart-item-title" style="font-size:1.0625rem">{{ item.product.title }}</span>
                      {% if item.variant.title != 'Default Title' %}
                        <span class="cart-item-variant">{{ item.variant.title }}</span>
                      {% endif %}
                    </div>
                    <span style="font-weight:600;color:var(--color-primary)">{{ item.line_price | money }}</span>
                  </div>
                  <div style="display:flex;justify-content:space-between;align-items:center;margin-top:0.5rem">
                    <div class="qty-selector" style="height:40px">
                      <button type="button" style="width:36px" onclick="document.getElementById('updates_{{ item.key }}').stepDown(); document.getElementById('cart').submit();">
                        <span class="material-symbols-outlined" style="font-size:18px">remove</span>
                      </button>
                      <input type="number" name="updates[]" id="updates_{{ item.key }}" value="{{ item.quantity }}" min="0" style="width:36px;font-size:0.875rem">
                      <button type="button" style="width:36px" onclick="document.getElementById('updates_{{ item.key }}').stepUp(); document.getElementById('cart').submit();">
                        <span class="material-symbols-outlined" style="font-size:18px">add</span>
                      </button>
                    </div>
                    <a href="{{ item.url_to_remove }}" style="color:#6b6358;font-size:0.8125rem;display:flex;align-items:center;gap:0.25rem;transition:color 0.2s" onmouseover="this.style.color='#b83230'" onmouseout="this.style.color='#6b6358'">
                      <span class="material-symbols-outlined" style="font-size:16px">delete</span> Remove
                    </a>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        </form>

        <div style="max-width:400px;margin-left:auto;width:100%">
          <div class="card" style="padding:2rem">
            <h2 style="font-family:var(--font-heading-family);font-size:1.5rem;margin-bottom:1.5rem">Order Summary</h2>
            <div style="display:flex;flex-direction:column;gap:0.75rem;margin-bottom:1.5rem">
              <div style="display:flex;justify-content:space-between;color:#4a4e4a"><span>Subtotal</span><span>{{ cart.total_price | money }}</span></div>
              <div style="display:flex;justify-content:space-between;color:#4a4e4a"><span>Shipping</span><span>Calculated at checkout</span></div>
              <div style="height:1px;background:rgba(196,200,188,0.3);margin:0.5rem 0"></div>
              <div style="display:flex;justify-content:space-between;font-weight:700;font-size:1.125rem"><span>Total</span><span>{{ cart.total_price | money }}</span></div>
            </div>
            <button type="submit" form="cart" name="checkout" class="btn-primary" style="width:100%">
              Proceed to Checkout
              <span class="material-symbols-outlined">arrow_forward</span>
            </button>
            <div style="margin-top:1rem;display:flex;align-items:center;justify-content:center;gap:0.5rem;font-size:0.8125rem;color:#6b6358">
              <span class="material-symbols-outlined" style="font-size:16px">lock</span> Secure Checkout
            </div>
          </div>
        </div>
      </div>
    </div>
  {% else %}
    <div style="text-align:center;padding:5rem 0">
      <span class="material-symbols-outlined" style="font-size:64px;color:var(--color-primary-light);opacity:0.4;margin-bottom:1rem;display:block">shopping_bag</span>
      <h1 style="font-family:var(--font-heading-family);font-size:2.5rem;margin-bottom:1rem">Your Cart is Empty</h1>
      <p style="color:#4a4e4a;margin-bottom:2rem">Looks like you haven't added anything yet.</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn-primary">Start Shopping</a>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Cart Main",
  "settings": []
}
{% endschema %}
