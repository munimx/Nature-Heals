<section class="testimonials">
  <div class="testimonials-header">
    <span class="badge badge-green" style="margin-bottom:1rem;display:inline-flex">
      <span class="material-symbols-outlined" style="font-size:14px">favorite</span>
      {{ section.settings.badge_text }}
    </span>
    <h2>{{ section.settings.heading }}</h2>
    <p style="color:#4a4e4a;max-width:500px;margin:0 auto">{{ section.settings.subheading }}</p>
  </div>
  
  <div class="testimonials-scroll">
    {% for block in section.blocks %}
      <div class="testimonial-card">
        <div class="stars">
          {% for i in (1..5) %}
            <span class="material-symbols-outlined">{% if i <= block.settings.rating %}star{% else %}star_border{% endif %}</span>
          {% endfor %}
        </div>
        <blockquote>"{{ block.settings.quote }}"</blockquote>
        <cite>— {{ block.settings.author }}</cite>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "badge_text", "label": "Badge", "default": "Loved by Thousands" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What Our Customers Say" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Real stories from real people finding natural relief." }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Rating", "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "This oil has changed my life. I use it every night after work and the relief is immediate." },
        { "type": "text", "id": "author", "label": "Author", "default": "Sarah M." }
      ]
    }
  ],
  "presets": [{
    "name": "Testimonials",
    "blocks": [
      { "type": "testimonial", "settings": { "rating": 5, "quote": "This oil has changed my life. I use it every night after work and the relief is immediate and lasting.", "author": "Sarah M." } },
      { "type": "testimonial", "settings": { "rating": 5, "quote": "As a yoga instructor, I need something natural and effective. Nature Heals is the only oil I trust for my practice.", "author": "James K." } },
      { "type": "testimonial", "settings": { "rating": 4, "quote": "The earthy scent is so calming. I apply before bed and wake up feeling refreshed. Truly a game changer.", "author": "Priya R." } }
    ]
  }]
}
{% endschema %}
